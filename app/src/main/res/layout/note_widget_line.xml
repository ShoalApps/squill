<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/note_widget_check" android:layout_width="48dp" android:layout_height="48dp"
        android:gravity="center" android:textSize="24sp" android:textColor="@color/note_widget_foreground" android:contentDescription="Toggle checklist item" />
    <TextView android:id="@+id/note_widget_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:textColor="@color/note_widget_foreground" android:textSize="14sp" android:paddingVertical="5dp" />
</LinearLayout>
