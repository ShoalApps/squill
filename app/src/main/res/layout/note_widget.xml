<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/note_widget_background">
    <TextView android:id="@+id/note_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/note_widget_description" android:textColor="@color/note_widget_foreground" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="8dp" />
    <ListView android:id="@+id/note_widget_list" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="0dp" />
    <TextView android:id="@+id/note_widget_choose" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Choose another note" android:textColor="@color/note_widget_foreground" android:textSize="12sp" android:paddingTop="8dp" />
</LinearLayout>
